# ==============================================================================
# Credit Book - Global Environment Configuration Example
# Copy to .env or export into your macOS shell before launching servers
# ==============================================================================

# Server Port
PORT=8080

# MySQL Database Configuration
# Update with your custom local MySQL username and password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/creditbook_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=creditBookSecretKeyForJwtAuthenticationMustBeAtLeast256BitsLong2026EnterpriseFinancialAppKey
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
